{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/qwen3:30b-a3b-instruct-2507-q4_K_M",
  "small_model": "ollama/qwen3:30b-a3b-instruct-2507-q4_K_M",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:30b-a3b-instruct-2507-q4_K_M": {
          "name": "Qwen3 30B A3B Instruct 2507 (q4_K_M)",
          "tools": true,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },

  "mcp": {
    "openwiki": {
      "type": "local",
      "command": [
        ".venv/Scripts/python.exe", "-m", "openwiki", "mcp",
        "--wiki", "output/wiki", "--index", "output/index", "--graph", "output/graph"
      ],
      "enabled": true
    }
  },

  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "openwiki": {
      "type": "local",
      "command": [
        "<OPENWIKI>/.venv/bin/python", "-m", "openwiki", "mcp",
        "--wiki", "output/wiki", "--index", "output/index", "--graph", "output/graph"
      ],
      "cwd": "<OPENWIKI>",
      "enabled": true
    }
  }
}
